# job-dashboard-site environment variables
# Copy to .env and fill in real values. Never commit .env.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
# Bucket holding resume.md + job_profile.json (defaults to "candidate")
SUPABASE_BUCKET=candidate

# Netlify
NETLIFY_SITE_ID=909bff86-27e5-4a34-b09e-bbb6cdc04a39
NETLIFY_AUTH_TOKEN=your-netlify-token

# Scraper (optional)
SEEK_PROXY_URL=
SCRAPE_RATE_LIMIT=2

# AI / Document generation (if using n8n webhook)
AI_WEBHOOK_URL=
AI_WEBHOOK_SECRET=
